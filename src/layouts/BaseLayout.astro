---
/**
 * The document shell every page shares: <head> (title, description, canonical, icons, link
 * previews) and an empty <body>. The 3D desk page fills the body itself; 2D pages use
 * PageLayout on top of this.
 */
import '@fontsource/josefin-sans/400.css';
import '@fontsource/josefin-sans/600.css';
import '@fontsource/josefin-sans/700.css';
import '@fontsource/poiret-one/400.css';
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/site';

interface Props {
	/** Page-specific title; rendered as "<title> · Travel — Aaron Yalong". Omit on the home page. */
	title?: string;
	description?: string;
	/** Classes for <body>, e.g. the desk page's full-screen, always-dark mode. */
	bodyClass?: string;
	/**
	 * Link-preview card (1200×630). Defaults to the desk (public/og/home.jpg); a trip page with a
	 * cover photo passes a crop of it.
	 */
	image?: { src: string; alt: string };
	/** Open Graph type: "article" for trip pages. */
	type?: 'website' | 'article';
}

const HOME_CARD = {
	src: '/og/home.jpg',
	alt: "An old-style world map on a dark desk, with brass pins on the places in Aaron Yalong's travel scrapbook",
};

const { title, description = SITE_DESCRIPTION, bodyClass, image = HOME_CARD, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{fullTitle}</title>
		<link rel="canonical" href={canonical} />

		<!-- Link previews (LinkedIn, Slack, iMessage, X…). -->
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={image.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={image.alt} />
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
