---
/**
 * Layout for the 2D pages (trip list, credits, later the trip scrapbooks): a slim header with a
 * way back to the desk, the page content, and a footer linking to the portfolio. No client JS.
 */
import BaseLayout from './BaseLayout.astro';
import { PORTFOLIO_URL } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description}>
	<header class="site-header">
		<nav class="container inner" aria-label="Site">
			<a class="home" href="/">← Back to the desk</a>
			<ul>
				<li><a href="/trips/">All trips</a></li>
				<li><a href="/credits/">Credits</a></li>
			</ul>
		</nav>
	</header>
	<main id="main" class="container">
		<slot />
	</main>
	<footer class="site-footer">
		<div class="container inner">
			<p>© {year} Aaron Yalong</p>
			<a href={PORTFOLIO_URL}>aaronyalong.com</a>
		</div>
	</footer>
</BaseLayout>

<style>
	:global(body) {
		display: flex;
		flex-direction: column;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3) var(--space-6);
		padding-block: var(--space-4);
	}

	.site-header {
		border-bottom: 1px solid var(--color-border);
		font-size: var(--text-sm);
	}

	.site-header ul {
		display: flex;
		gap: var(--space-4);
		padding: 0;
		list-style: none;
	}

	.site-header a {
		color: var(--color-text);
		text-decoration: none;
	}

	.site-header a:hover {
		color: var(--color-accent);
	}

	.home {
		font-weight: 600;
	}

	main {
		flex: 1;
		padding-block: var(--space-12) var(--space-16);
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
</style>
