---
/**
 * Layout for the 2D pages (trip list, trip scrapbooks, 404): dark like the desk's room, in its
 * art deco: a header with the title spaced out in Poiret One and a gold rule, the page content,
 * and a footer with the portfolio link and the one credit the site must show (Earth's textures
 * are CC BY 4.0). No client JS.
 */
import BaseLayout from './BaseLayout.astro';
import { PORTFOLIO_URL } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; alt: string };
	type?: 'website' | 'article';
}

const { title, description, image, type } = Astro.props;
const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description} image={image} type={type} bodyClass="on-dark deco-page">
	<header class="site-header">
		<nav class="container inner" aria-label="Site">
			<a class="brand" href="/">Atlas</a>
			<ul class="caps">
				<li><a href="/">The desk</a></li>
				<li><a href="/trips/">All trips</a></li>
			</ul>
		</nav>
		<div class="container"><div class="deco-rule" aria-hidden="true"><span></span></div></div>
	</header>
	<main id="main" class="container">
		<slot />
	</main>
	<footer class="site-footer">
		<div class="container">
			<div class="deco-rule" aria-hidden="true"><span></span></div>
			<div class="inner">
				<p>© {year} Aaron Yalong · <a href={PORTFOLIO_URL}>aaronyalong.com</a></p>
				<p class="credit">
					Earth imagery: <a href="https://www.solarsystemscope.com/textures/">Solar System Scope</a>,{' '}
					<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
				</p>
			</div>
		</div>
	</footer>
</BaseLayout>

<style>
	:global(body.deco-page) {
		display: flex;
		flex-direction: column;
		/* The room: near-black, with a faint gold glow from above, like the ceiling light. */
		background:
			radial-gradient(ellipse 70% 40% at 50% -5%, rgb(201 164 92 / 0.12), transparent 70%),
			var(--scene-bg);
		background-attachment: fixed;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3) var(--space-6);
		padding-block: var(--space-4);
	}

	.brand {
		color: var(--ivory);
		font-family: var(--font-display);
		font-size: 1.6rem;
		letter-spacing: 0.32em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.brand:hover {
		color: var(--gold-bright);
	}

	.site-header ul {
		display: flex;
		gap: var(--space-6);
		padding: 0;
		font-size: 0.75rem;
		list-style: none;
	}

	.site-header ul a {
		color: var(--gold);
		text-decoration: none;
	}

	.site-header ul a:hover {
		color: var(--gold-bright);
	}

	main {
		flex: 1;
		padding-block: var(--space-12) var(--space-16);
	}

	.site-footer {
		color: color-mix(in srgb, var(--ivory) 60%, transparent);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}

	.site-footer a {
		color: var(--gold);
	}

	.site-footer a:hover {
		color: var(--gold-bright);
	}

	.credit {
		font-size: 0.72rem;
	}
</style>
