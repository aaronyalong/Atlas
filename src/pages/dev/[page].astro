---
/**
 * Dev-only pages, served by `npm run dev` at /dev/<page> and never built: getStaticPaths lists
 * them only in dev, so a production build emits nothing for this route, and the sitemap (built
 * from a fixed list of real pages) never mentions it.
 *
 *   /dev/compare: before/after sliders for the realism pass. The screenshots live in
 *   src/dev-shots/ (git-ignored; taken locally by the screenshot script), named
 *   <step>-<name>-<view>.jpg, e.g. 3-pbr-desk.jpg. Step 0 is "before".
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listShots } from '../../lib/dev-shots';

export const getStaticPaths = (() => (import.meta.env.DEV ? [{ params: { page: 'compare' } }] : [])) satisfies GetStaticPaths;

// Listed from disk and served by ./shots/[file].ts, never imported: an import would make Vite
// copy every screenshot into the production build even though this page isn't built there.
const files = await listShots();
const shots = Object.fromEntries(files.map((f) => [`/${f}`, `/dev/shots/${f}`]));

interface Step {
	index: number;
	name: string;
	label: string;
}

const STEP_LABELS: Record<string, string> = {
	before: 'Before',
	fov: '1 · Narrower lens (35°)',
	hdri: '2 · HDRI environment',
	pbr: '3 · PBR wood and paper',
	ao: '4 · Ambient occlusion + contact shadows',
	post: '5 · Bloom, depth of field, vignette, grain',
	wear: '6 · Curl and edge wear',
};

// Parse "<step>-<name>-<view>.jpg" into a table of view → step → url.
const views = new Map<string, Map<number, string>>();
const steps = new Map<number, Step>();
for (const [path, url] of Object.entries(shots)) {
	const m = path.match(/\/(\d+)-([a-z]+)-([a-z]+)\.jpg$/);
	if (!m) continue;
	const index = Number(m[1]);
	const name = m[2];
	const view = m[3];
	steps.set(index, { index, name, label: STEP_LABELS[name] ?? name });
	if (!views.has(view)) views.set(view, new Map());
	views.get(view)!.set(index, url);
}
const stepList = [...steps.values()].sort((a, b) => a.index - b.index);
const VIEW_ORDER = ['desk', 'hover', 'open', 'phone'];
const viewList = [...views.keys()].sort((a, b) => VIEW_ORDER.indexOf(a) - VIEW_ORDER.indexOf(b));
const table = Object.fromEntries(viewList.map((v) => [v, Object.fromEntries(views.get(v)!)]));
---

<BaseLayout title="Compare (dev)" bodyClass="on-dark">
	<main class="compare">
		<h1>Realism pass: before / after</h1>
		<p class="lede">
			Dev-only. Pick a step; the slider compares it with the step before (or with the original).
			Drag the handle or use the arrow keys.
		</p>

		{
			stepList.length === 0 ? (
				<p class="todo">No screenshots in src/dev-shots/. They're local-only; see the note at the top of this file.</p>
			) : (
				<>
					<div class="controls" role="group" aria-label="Step">
						{stepList
							.filter((s) => s.index > 0)
							.map((s) => (
								<button type="button" class="step" data-step={s.index} aria-pressed={s.index === stepList.at(-1)!.index}>
									{s.label}
								</button>
							))}
						<label class="base">
							<input type="checkbox" id="vs-original" /> compare with the original
						</label>
					</div>

					{viewList.map((view) => (
						<section class="view" data-view={view}>
							<h2>{view}</h2>
							<div class={`slider ${view === 'phone' ? 'portrait' : ''}`}>
								<img class="after" alt={`${view}, after`} />
								<img class="before" alt={`${view}, before`} />
								<div class="handle" aria-hidden="true" />
								<input type="range" min="0" max="100" value="50" aria-label={`Reveal ${view}`} />
								<span class="tag tag-before" />
								<span class="tag tag-after" />
							</div>
						</section>
					))}
				</>
			)
		}
	</main>

	<script is:inline define:vars={{ table, stepList }}>
		let step = stepList.at(-1).index;
		const vsOriginal = document.getElementById('vs-original');
		const labelOf = (i) => stepList.find((s) => s.index === i)?.label ?? `step ${i}`;

		function render() {
			const prev = vsOriginal.checked ? 0 : Math.max(0, step - 1);
			document.querySelectorAll('.view').forEach((el) => {
				const v = el.dataset.view;
				const before = el.querySelector('.before');
				const after = el.querySelector('.after');
				before.src = table[v][prev] ?? '';
				after.src = table[v][step] ?? '';
				el.querySelector('.tag-before').textContent = labelOf(prev);
				el.querySelector('.tag-after').textContent = labelOf(step);
			});
			document.querySelectorAll('button.step').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.step) === step)));
		}
		document.querySelectorAll('button.step').forEach((b) =>
			b.addEventListener('click', () => {
				step = Number(b.dataset.step);
				render();
			}),
		);
		vsOriginal.addEventListener('change', render);
		document.querySelectorAll('.slider').forEach((s) => {
			const range = s.querySelector('input');
			const set = () => s.style.setProperty('--cut', range.value + '%');
			range.addEventListener('input', set);
			set();
		});
		render();
	</script>
</BaseLayout>

<style>
	.compare {
		max-width: 72rem;
		margin-inline: auto;
		padding: var(--space-8) var(--gutter) var(--space-16);
	}

	.lede {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	.step {
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		font-size: var(--text-sm);
		cursor: pointer;
	}

	.step[aria-pressed='true'] {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 20%, var(--color-surface));
	}

	.base {
		margin-left: auto;
		font-size: var(--text-sm);
	}

	.view {
		margin-top: var(--space-8);
	}

	.view h2 {
		font-size: var(--text-lg);
		text-transform: capitalize;
	}

	/* The "before" image sits on top, clipped to the left of the cut; the slider sets --cut. */
	.slider {
		--cut: 50%;
		position: relative;
		margin-top: var(--space-3);
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: #000;
	}

	.slider.portrait {
		max-width: 24rem;
		aspect-ratio: 390 / 844;
	}

	.slider img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.slider .before {
		clip-path: inset(0 calc(100% - var(--cut)) 0 0);
	}

	.handle {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--cut);
		width: 2px;
		background: #fff;
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5);
		pointer-events: none;
	}

	.slider input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: ew-resize;
	}

	.tag {
		position: absolute;
		bottom: var(--space-2);
		padding: 2px var(--space-2);
		border-radius: 4px;
		background: rgb(0 0 0 / 0.65);
		color: #fff;
		font-size: var(--text-sm);
		pointer-events: none;
	}

	.tag-before {
		left: var(--space-2);
	}

	.tag-after {
		right: var(--space-2);
	}
</style>
