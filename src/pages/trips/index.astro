---
/**
 * "Skip the 3D": every trip as a plain list, for screen readers, slow phones and search engines.
 * Built from the trips collection, so a new trip file shows up here automatically.
 */
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import { formatTripDates, getTrips, tripHref, tripName } from '../../lib/trips';

const trips = await getTrips();
---

<PageLayout title="All trips" description="Every trip in Aaron Yalong's travel scrapbook, as a plain list.">
	<h1>All trips</h1>
	<p class="lede">The whole scrapbook as a plain list, without the 3D desk.</p>
	<ul class="trips">
		{
			trips.map((trip) => {
				const dates = formatTripDates(trip);
				return (
					<li>
						{trip.data.cover && (
							<Image class="thumb" src={trip.data.cover} alt="" width={160} height={120} fit="cover" />
						)}
						<a class="name" href={tripHref(trip)}>
							{tripName(trip)}
						</a>
						{dates ? <span class="dates">{dates}</span> : <span class="todo">TODO: dates</span>}
						{trip.data.blurb ? (
							<p class="blurb">{trip.data.blurb}</p>
						) : (
							<p class="blurb">
								<span class="todo">TODO: blurb</span>
							</p>
						)}
					</li>
				);
			})
		}
	</ul>
</PageLayout>

<style>
	.lede {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
	}

	.trips {
		max-width: var(--prose-width);
		margin-top: var(--space-8);
		padding: 0;
		list-style: none;
	}

	.trips li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		padding-block: var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}

	.name {
		font-weight: 600;
	}

	/* Decorative: the link text says where it goes, so the thumbnail has empty alt. */
	.thumb {
		width: 4rem;
		height: 3rem;
		object-fit: cover;
		border-radius: 3px;
	}

	.dates {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.blurb {
		flex-basis: 100%;
	}
</style>
