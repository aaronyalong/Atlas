---
/**
 * One trip's page. Phase 2 stub: title, dates, blurb and cover, so "Open trip" on the desk leads
 * somewhere. Phase 4 turns this into the 2D scrapbook (taped photos, journal text).
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { formatTripDates, getTrips, tripName, type Trip } from '../../lib/trips';

export const getStaticPaths = (async () => {
	const trips = await getTrips();
	return trips.map((trip) => ({ params: { slug: trip.id }, props: { trip } }));
}) satisfies GetStaticPaths;

const { trip } = Astro.props as { trip: Trip };
const { title, place, blurb, cover, coverAlt } = trip.data;
const dates = formatTripDates(trip);
const { Content } = await render(trip);
---

<PageLayout title={tripName(trip)} description={blurb ?? `${tripName(trip)}: a page from Aaron Yalong's travel scrapbook.`}>
	<article>
		<p class="place">{place}</p>
		<h1>{title}</h1>
		<p class="dates">{dates ?? <span class="todo">TODO: dates</span>}</p>
		{
			cover ? (
				<Image src={cover} alt={coverAlt ?? ''} width={1200} class="cover" />
			) : (
				<p>
					<span class="todo">TODO: cover photo</span>
				</p>
			)
		}
		<p class="blurb">{blurb ?? <span class="todo">TODO: blurb</span>}</p>
		<div class="journal">
			<Content />
			<p><span class="todo">TODO: scrapbook page (phase 4)</span></p>
		</div>
	</article>
</PageLayout>

<style>
	article {
		max-width: var(--prose-width);
	}

	article > * + * {
		margin-top: var(--space-4);
	}

	.place {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	h1 {
		margin-top: var(--space-1);
	}

	.dates {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
	}

	.cover {
		border-radius: var(--radius);
	}

	.blurb {
		font-size: var(--text-lg);
	}
</style>
