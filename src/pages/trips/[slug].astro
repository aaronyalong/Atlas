---
/**
 * One trip's scrapbook page: a sheet of ivory card with a hairline of gold round it (the desk's
 * art deco), and the trip's photos laid out on it as one tidy collage of prints: the cover
 * large, held by gold photo corners, the rest fitted round it, each a touch off square as if
 * placed by hand. A photo's caption, where it has one, is set small on the photo itself. Then
 * the journal, and on to the next trip. Clicking a photo opens it large (a <dialog>), with the
 * arrow keys or buttons stepping through the rest; without JavaScript, each photo links to its
 * large version.
 *
 * Missing photos show as a visible TODO. The blurb and journal are optional: without them,
 * they're left out. The page shows no dates: a trip's `start` only puts the trips in order.
 * Every photo goes through astro:assets, which re-encodes it and strips EXIF/GPS metadata; the
 * original file is never published.
 */
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getTrips, hasJournal, tripHref, tripName, type Trip } from '../../lib/trips';

export const getStaticPaths = (async () => {
	const trips = await getTrips();
	return trips.map((trip, i) => ({
		params: { slug: trip.id },
		// Wraps round, so the last trip leads back to the first.
		props: { trip, previous: trips[(i - 1 + trips.length) % trips.length], next: trips[(i + 1) % trips.length] },
	}));
}) satisfies GetStaticPaths;

const { trip, previous, next } = Astro.props as { trip: Trip; previous: Trip; next: Trip };
const { title, place, blurb, cover, coverAlt, photos } = trip.data;
const { Content } = await render(trip);
const journal = hasJournal(trip);

// Link preview: the cover, cropped to 1200 × 630; without one, the default desk card.
const preview = cover
	? {
			src: (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src,
			alt: coverAlt ?? '',
		}
	: undefined;

// Every photo at a large size, for the viewer: the cover, then the gallery.
const large = async (src: ImageMetadata) => (await getImage({ src, width: 2000, format: 'webp', quality: 82 })).src;
const coverLarge = cover ? await large(cover) : undefined;
const photosLarge = await Promise.all(photos.map((p) => large(p.src)));

/*
 * The collage is a grid three prints across. An upright photo fills one cell (3:4) and a wide
 * one two (3:2), each cropped to its cell; the viewer shows it whole. How the cover sits:
 *   mosaic  an upright cover, two cells square, with the first two photos stacked beside it
 *   banner  a wide cover, right across the top
 *   pair    an upright cover and the trip's one other photo, side by side
 *   solo    the cover alone
 */
const isWide = (image: ImageMetadata) => image.width > image.height;
const layout = photos.length === 0 ? 'solo' : cover && isWide(cover) ? 'banner' : photos.length === 1 ? 'pair' : 'mosaic';

// Small deterministic tilts, so the prints look placed by hand rather than on a grid.
const tilt = (i: number) => [-0.7, 0.9, -0.5, 0.6, -1, 0.4][i % 6];
---

<PageLayout
	title={tripName(trip)}
	description={blurb ?? `${tripName(trip)}: a page from Aaron Yalong's travel scrapbook.`}
	image={preview}
	type="article"
>
	<article class="sheet">
		<header class="head">
			<p class="caps place"><span>{place}</span></p>
			<h1>{title}</h1>
			<div class="deco-rule" aria-hidden="true"><span></span></div>
			{blurb && <p class="blurb">{blurb}</p>}
		</header>

		<section class={`collage is-${layout}`} aria-label="Photos">
			<figure class={`print cover${cover && isWide(cover) ? ' is-wide' : ''}`} style={`--tilt: ${tilt(0)}deg`}>
				{
					cover ? (
						<a class="zoom" href={coverLarge} data-caption="">
							<Image src={cover} alt={coverAlt ?? ''} width={1100} class="photo" />
						</a>
					) : (
						<div class="zoom placeholder">
							<span class="todo">TODO: cover photo</span>
						</div>
					)
				}
			</figure>
			{
				photos.map((photo, i) => (
					<figure class={`print${isWide(photo.src) ? ' is-wide' : ''}`} style={`--tilt: ${tilt(i + 1)}deg`}>
						<a class="zoom" href={photosLarge[i]} data-caption={photo.caption ?? ''}>
							<Image src={photo.src} alt={photo.alt} width={isWide(photo.src) ? 1100 : 700} class="photo" />
						</a>
						{photo.caption && <figcaption>{photo.caption}</figcaption>}
					</figure>
				))
			}
		</section>
		{
			photos.length === 0 && (
				<p class="no-photos">
					<span class="todo">TODO: photos</span>
				</p>
			)
		}

		{
			journal && (
				<section class="journal" aria-label="Journal">
					<div class="prose">
						<Content />
					</div>
				</section>
			)
		}
	</article>

	{
		(cover || photos.length > 0) && (
			<dialog class="viewer" aria-label="Photo">
				<figure>
					<img alt="" />
					<figcaption />
				</figure>
				<p class="viewer-count" aria-live="polite" />
				<button type="button" class="viewer-close deco-tag" aria-label="Close">
					×
				</button>
				<button type="button" class="viewer-prev deco-tag" aria-label="Previous photo">
					←
				</button>
				<button type="button" class="viewer-next deco-tag" aria-label="Next photo">
					→
				</button>
			</dialog>
		)
	}

	<nav class="pager" aria-label="More trips">
		<a class="deco-tag" href={tripHref(previous)} rel="prev"><span aria-hidden="true">←</span> {tripName(previous)}</a>
		<a class="deco-tag" href={tripHref(next)} rel="next">{tripName(next)} <span aria-hidden="true">→</span></a>
	</nav>
</PageLayout>

<style>
	/* The page itself: a sheet of ivory card stock with one hairline of gold round it, its
	   corners cut like a deco menu card. Light inside, on the dark room. */
	.sheet {
		--ink: #2a2622;
		--muted: #6b6259;
		--color-accent: var(--gold-ink);
		--color-accent-hover: #5e4214;
		--color-text-muted: var(--muted);
		position: relative;
		max-width: 60rem;
		margin-inline: auto;
		padding: clamp(2.5rem, 6vw, 4.25rem) clamp(1.5rem, 5.5vw, 3.75rem) clamp(2.5rem, 6vw, 4.5rem);
		background:
			radial-gradient(circle at 20% 10%, rgb(255 255 255 / 0.5), transparent 55%),
			radial-gradient(circle at 90% 95%, rgb(120 90 50 / 0.08), transparent 50%),
			var(--paper);
		box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.8);
		color: var(--ink);
		color-scheme: light;
	}

	/* The hairline, drawn a side at a time so it can follow the cut corners (a border can't). */
	.sheet::before {
		--cut: 14px;
		--line: color-mix(in srgb, var(--gold-ink) 60%, transparent);
		--side: linear-gradient(var(--line), var(--line));
		--rise: linear-gradient(135deg, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px) calc(50% + 0.5px), transparent calc(50% + 0.5px));
		--fall: linear-gradient(45deg, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px) calc(50% + 0.5px), transparent calc(50% + 0.5px));
		content: '';
		position: absolute;
		inset: 12px;
		background:
			var(--side) center top / calc(100% - 2 * var(--cut)) 1px,
			var(--side) center bottom / calc(100% - 2 * var(--cut)) 1px,
			var(--side) left center / 1px calc(100% - 2 * var(--cut)),
			var(--side) right center / 1px calc(100% - 2 * var(--cut)),
			var(--rise) left top / var(--cut) var(--cut),
			var(--rise) right bottom / var(--cut) var(--cut),
			var(--fall) right top / var(--cut) var(--cut),
			var(--fall) left bottom / var(--cut) var(--cut);
		background-repeat: no-repeat;
		pointer-events: none;
	}

	.head {
		text-align: center;
	}

	/* The place between two gold rules. */
	.place {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		color: var(--gold-ink);
		font-size: 0.78rem;
	}

	.place::before,
	.place::after {
		content: '';
		flex: 1;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	h1 {
		margin-top: var(--space-4);
		font-size: clamp(2.4rem, 7vw, 4.25rem);
		letter-spacing: 0.12em;
		line-height: 1.05;
		text-transform: uppercase;
	}

	.head .deco-rule {
		max-width: 16rem;
		margin: var(--space-6) auto 0;
		color: var(--gold-ink);
	}

	.blurb {
		max-width: 38rem;
		margin: var(--space-6) auto 0;
		font-size: 1.2rem;
		line-height: 1.6;
	}

	/* The collage: every photo of the trip as a print, on one grid. Two across on a phone, the
	   cover right across the top; three across on a wider screen, laid out by .is-* below. */
	.collage {
		--gap: clamp(0.9rem, 2.6vw, 1.6rem);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--gap);
		margin-top: var(--space-12);
	}

	/* A print: a thin, even border of white paper, a soft shadow, and a touch of tilt. */
	.print {
		--border: clamp(0.3rem, 0.8vw, 0.45rem);
		position: relative;
		display: grid;
		margin: 0;
		padding: var(--border);
		background: #fbfaf6;
		box-shadow:
			0 0 0 1px rgb(60 45 20 / 0.06),
			0 1px 2px rgb(40 30 15 / 0.18),
			0 14px 26px -16px rgb(40 30 15 / 0.55);
		transform: rotate(var(--tilt, 0deg));
	}

	/* The photo's cell: upright, or wide and two cells across. The photo is cropped to fill it. */
	.zoom {
		position: relative;
		display: block;
		aspect-ratio: 3 / 4;
		overflow: hidden;
	}

	.print.is-wide {
		grid-column: span 2;
	}

	.print.is-wide .zoom {
		aspect-ratio: 3 / 2;
	}

	.photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cover {
		grid-column: 1 / -1;
	}

	/* A print left on its own in the last row of two goes right across. */
	.print:last-child:nth-child(even) {
		grid-column: 1 / -1;
	}

	.is-solo {
		grid-template-columns: minmax(0, 26rem);
		justify-content: center;
	}

	@media (min-width: 40rem) {
		.collage {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.print:last-child:nth-child(even) {
			grid-column: auto;
		}

		.print.is-wide:last-child:nth-child(even) {
			grid-column: span 2;
		}

		/* Mosaic: the cover two cells square, as tall as the two photos stacked beside it. */
		.is-mosaic .cover {
			grid-column: span 2;
			grid-row: span 2;
		}

		.is-mosaic .cover .zoom {
			aspect-ratio: auto;
		}

		/* One print alone in the last row sits in the middle. */
		.is-mosaic .print:not(.is-wide):last-child:nth-child(3n + 1) {
			grid-column: 2;
		}

		.is-pair {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			max-width: 44rem;
			margin-inline: auto;
		}

		.is-pair .cover {
			grid-column: auto;
		}

		.is-solo {
			grid-template-columns: minmax(0, 26rem);
		}
	}

	/* Photo corners, the kind that hold a print in an album: gold, on the cover. */
	.cover::after {
		--corner: clamp(1.1rem, 3vw, 1.7rem);
		content: '';
		position: absolute;
		inset: -3px;
		background:
			linear-gradient(135deg, #b08a45 0 49%, transparent 50%) top left,
			linear-gradient(225deg, #c9a45c 0 49%, transparent 50%) top right,
			linear-gradient(315deg, #a37d3a 0 49%, transparent 50%) bottom right,
			linear-gradient(45deg, #b08a45 0 49%, transparent 50%) bottom left;
		background-repeat: no-repeat;
		background-size: var(--corner) var(--corner);
		filter: drop-shadow(0 1px 1px rgb(40 30 15 / 0.35));
		pointer-events: none;
	}

	.placeholder {
		display: grid;
		place-items: center;
		background:
			radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.12), transparent 60%),
			linear-gradient(180deg, var(--navy), #2a3b55);
	}

	.placeholder .todo {
		border-color: rgb(255 255 255 / 0.8);
		color: #fff;
	}

	.no-photos {
		margin-top: var(--space-8);
		text-align: center;
	}

	/* A caption: a few words set small along the photo's foot, quiet enough to miss, on a faint
	   shade so they read over whatever is there. */
	.print figcaption {
		position: absolute;
		inset: auto var(--border) var(--border);
		padding: 1.6rem 0.8rem 0.6rem;
		background: linear-gradient(transparent, rgb(0 0 0 / 0.5));
		color: rgb(255 255 255 / 0.85);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		line-height: 1.3;
		pointer-events: none;
	}

	/* The journal: between gold rules, opening with a deco drop cap. */
	.journal {
		margin-top: var(--space-12);
		padding-block: var(--space-8);
		border-block: 1px solid color-mix(in srgb, var(--gold-ink) 45%, transparent);
		font-size: 1.1rem;
		line-height: 1.75;
	}

	.journal .prose {
		max-width: 65ch;
		margin-inline: auto;
	}

	.journal .prose :global(* + *) {
		margin-top: 1.1em;
	}

	.journal .prose :global(> p:first-child::first-letter) {
		float: left;
		margin: 0.08em 0.12em 0 0;
		color: var(--gold-ink);
		font-family: var(--font-display);
		font-size: 4em;
		line-height: 0.8;
	}

	.journal .prose :global(h2),
	.journal .prose :global(h3) {
		margin-top: 1.6em;
		font-size: 1.5rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.journal .prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	/* On to the previous and next trips: deco tags on the dark room. */
	.pager {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: 60rem;
		margin: var(--space-12) auto 0;
	}

	.pager a {
		--cut: 8px;
		padding: 0.8rem 1.2rem 0.65rem;
		color: var(--ivory);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.pager a:hover,
	.pager a:focus-visible {
		--line: var(--gold-bright);
		--fill: color-mix(in srgb, #2a1f12 92%, transparent);
		color: var(--gold-bright);
		outline: none;
	}

	/* The photos open in the viewer. */
	a.zoom {
		cursor: zoom-in;
	}

	.zoom:focus-visible {
		outline: 2px solid var(--gold-ink);
		outline-offset: 4px;
	}

	/* The viewer: one photo at a time, large, on the dark room. */
	.viewer {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ivory);
	}

	.viewer::backdrop {
		background: rgb(10 8 6 / 0.96);
	}

	.viewer[open] {
		display: grid;
		place-items: center;
	}

	.viewer figure {
		position: relative;
		margin: 0;
		padding: 3.5rem 1rem 4.5rem;
	}

	.viewer img {
		display: block;
		max-width: min(92vw, 80rem);
		max-height: calc(100dvh - 9rem);
		width: auto;
		height: auto;
		box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.9);
	}

	/* The caption, in the photo's corner as on its print. */
	.viewer figcaption {
		position: absolute;
		bottom: calc(4.5rem + 1rem);
		left: calc(1rem + 1.25rem);
		color: rgb(255 255 255 / 0.78);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-shadow: 0 1px 4px rgb(0 0 0 / 0.55);
		pointer-events: none;
	}

	.viewer figcaption:empty {
		display: none;
	}

	.viewer-count {
		position: fixed;
		top: 1.4rem;
		left: 50%;
		transform: translateX(-50%);
		color: color-mix(in srgb, var(--ivory) 70%, transparent);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.2em;
	}

	.viewer button {
		--cut: 8px;
		position: fixed;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 0;
		color: var(--ivory);
		font: inherit;
		font-size: 1.3rem;
		cursor: pointer;
	}

	.viewer button:hover,
	.viewer button:focus-visible {
		--line: var(--gold-bright);
		--fill: color-mix(in srgb, #2a1f12 92%, transparent);
		color: var(--gold-bright);
		outline: none;
	}

	.viewer-close {
		top: 1rem;
		right: 1rem;
	}

	.viewer-prev,
	.viewer-next {
		top: calc(50% - 1.5rem);
	}

	.viewer-prev {
		left: 1rem;
	}

	.viewer-next {
		right: 1rem;
	}

	/* On a phone the arrows sit under the photo, not over it. */
	@media (max-width: 40rem) {
		.viewer-prev,
		.viewer-next {
			top: auto;
			bottom: 1rem;
		}

		.viewer-prev {
			left: calc(50% - 3.5rem);
		}

		.viewer-next {
			right: calc(50% - 3.5rem);
		}
	}

	.viewer[data-single] .viewer-prev,
	.viewer[data-single] .viewer-next,
	.viewer[data-single] .viewer-count {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.viewer[open] img {
			animation: viewer-in 0.25s var(--ease-out);
		}

		@keyframes viewer-in {
			from {
				opacity: 0;
				transform: scale(0.98);
			}
		}

		.print {
			transition: transform 0.3s var(--ease-out);
		}

		.print:hover {
			transform: rotate(0deg) scale(1.01);
		}
	}
</style>

<script>
	// The photo viewer: open the clicked photo in the <dialog>, step with the arrows (buttons or
	// keys), close with Esc, the × or a click outside the photo. Focus goes back to the photo.
	const viewer = document.querySelector<HTMLDialogElement>('dialog.viewer');
	const links = [...document.querySelectorAll<HTMLAnchorElement>('a.zoom')];
	if (viewer && links.length > 0 && typeof viewer.showModal === 'function') {
		const img = viewer.querySelector('img')!;
		const caption = viewer.querySelector('figcaption')!;
		const count = viewer.querySelector('.viewer-count')!;
		let current = 0;
		const show = (i: number) => {
			current = (i + links.length) % links.length;
			const link = links[current];
			img.src = link.href;
			img.alt = link.querySelector('img')?.alt ?? '';
			caption.textContent = link.dataset.caption ?? '';
			count.textContent = `${current + 1} / ${links.length}`;
		};
		viewer.toggleAttribute('data-single', links.length === 1);
		links.forEach((link, i) =>
			link.addEventListener('click', (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
				event.preventDefault();
				show(i);
				viewer.showModal();
			}),
		);
		viewer.querySelector('.viewer-close')!.addEventListener('click', () => viewer.close());
		viewer.querySelector('.viewer-prev')!.addEventListener('click', () => show(current - 1));
		viewer.querySelector('.viewer-next')!.addEventListener('click', () => show(current + 1));
		viewer.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			else if (event.key === 'ArrowRight') show(current + 1);
		});
		// A click on the dark around the photo (the dialog itself, not its contents) closes it.
		viewer.addEventListener('click', (event) => {
			if (event.target === viewer || event.target === viewer.querySelector('figure')) viewer.close();
		});
		viewer.addEventListener('close', () => {
			links[current].focus({ preventScroll: true });
			img.removeAttribute('src');
		});
	}
</script>
