---
/**
 * One trip's scrapbook page: a sheet of cream paper with the cover photo taped on, a postage-
 * stamp locator cut from the desk's map, the blurb, the journal text on lined paper, and the
 * rest of the photos as taped prints with handwritten captions. Then on to the next trip.
 *
 * Anything not written yet shows as a visible TODO (the deploy check refuses to ship those).
 * Every photo goes through astro:assets, which re-encodes it and strips EXIF/GPS metadata; the
 * original file is never published.
 */
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import '@fontsource/caveat/600.css';
import PageLayout from '../../layouts/PageLayout.astro';
import { MAP } from '../../lib/map/config';
import { createMapProjection, locate } from '../../lib/map/projection';
import { formatCoordinates, formatTripDates, getTrips, hasJournal, tripHref, tripName, type Trip } from '../../lib/trips';

export const getStaticPaths = (async () => {
	const trips = await getTrips();
	return trips.map((trip, i) => ({
		params: { slug: trip.id },
		// Wraps round, so the last trip leads back to the first.
		props: { trip, previous: trips[(i - 1 + trips.length) % trips.length], next: trips[(i + 1) % trips.length] },
	}));
}) satisfies GetStaticPaths;

const { trip, previous, next } = Astro.props as { trip: Trip; previous: Trip; next: Trip };
const { title, place, blurb, cover, coverAlt, photos, lat, lng } = trip.data;
const dates = formatTripDates(trip);
const { Content } = await render(trip);
const journal = hasJournal(trip);

// The locator stamp: the map texture, zoomed in around the trip's pin.
const geometry = createMapProjection(MAP, MAP.textureWidth);
const pin = locate(geometry, lat, lng);
const STAMP = 148; // px, the stamp's picture area
const ZOOM_WIDTH = 1300; // px, how wide the whole map is drawn behind it
const stampStyle = pin
	? [
			`background-image: url(/map/${MAP.name}.webp)`,
			`background-size: ${ZOOM_WIDTH}px auto`,
			`background-position: ${STAMP / 2 - pin[0] * ZOOM_WIDTH}px ${STAMP / 2 - (pin[1] * ZOOM_WIDTH) / geometry.aspect}px`,
		].join('; ')
	: undefined;

// Link preview: the cover, cropped to 1200 × 630; without one, the default desk card.
const preview = cover
	? {
			src: (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src,
			alt: coverAlt ?? '',
		}
	: undefined;

// Small deterministic tilts, so the prints look placed by hand rather than on a grid.
const tilt = (i: number) => [-2.2, 1.6, -1.1, 2.4, -1.8, 0.9][i % 6];
---

<PageLayout
	title={tripName(trip)}
	description={blurb ?? `${tripName(trip)}: a page from Aaron Yalong's travel scrapbook.`}
	image={preview}
	type="article"
>
	<article class="sheet">
		<header class="head">
			<p class="place">{place}</p>
			<h1>{title}</h1>
			<p class="dates">{dates ?? <span class="todo">TODO: dates</span>}</p>
		</header>

		<div class="lead">
			<figure class="print cover" style={`--tilt: ${tilt(0)}deg`}>
				<span class="tape tape-l" aria-hidden="true"></span>
				<span class="tape tape-r" aria-hidden="true"></span>
				{
					cover ? (
						<Image src={cover} alt={coverAlt ?? ''} width={1100} class="photo" />
					) : (
						<div class="photo placeholder">
							<span class="todo">TODO: cover photo</span>
						</div>
					)
				}
			</figure>

			<aside class="side">
				{
					pin && (
						<figure class="stamp" aria-label={`On the map: ${formatCoordinates(lat, lng)}`}>
							<div class="stamp-picture" style={stampStyle}>
								<span class="stamp-pin" aria-hidden="true" />
							</div>
							<figcaption>{formatCoordinates(lat, lng)}</figcaption>
						</figure>
					)
				}
				<p class="blurb">{blurb ?? <span class="todo">TODO: blurb</span>}</p>
			</aside>
		</div>

		<section class="journal" aria-label="Journal">
			{
				journal ? (
					<div class="prose">
						<Content />
					</div>
				) : (
					<p>
						<span class="todo">TODO: journal text</span>
					</p>
				)
			}
		</section>

		<section class="photos" aria-label="Photos">
			{
				photos.length > 0 ? (
					<ul>
						{photos.map((photo, i) => (
							<li>
								<figure class="print" style={`--tilt: ${tilt(i + 1)}deg`}>
									<span class="tape tape-c" aria-hidden="true" />
									<Image src={photo.src} alt={photo.alt} width={700} class="photo" />
									{photo.caption && <figcaption>{photo.caption}</figcaption>}
								</figure>
							</li>
						))}
					</ul>
				) : (
					<p>
						<span class="todo">TODO: photos</span>
					</p>
				)
			}
		</section>
	</article>

	<nav class="pager" aria-label="More trips">
		<a href={tripHref(previous)} rel="prev"><span aria-hidden="true">←</span> {tripName(previous)}</a>
		<a href={tripHref(next)} rel="next">{tripName(next)} <span aria-hidden="true">→</span></a>
	</nav>
</PageLayout>

<style>
	/* The page itself: a sheet of cream card stock in both themes, like the cards on the desk. */
	.sheet {
		--ink: #2a2622;
		--muted: #6b6259;
		--color-accent: #2f5bd3;
		--color-text-muted: var(--muted);
		position: relative;
		max-width: 60rem;
		margin-inline: auto;
		padding: clamp(1.5rem, 5vw, 3.5rem);
		background:
			radial-gradient(circle at 20% 10%, rgb(255 255 255 / 0.5), transparent 55%),
			radial-gradient(circle at 90% 95%, rgb(120 90 50 / 0.08), transparent 50%),
			#f4ecdc;
		border-radius: 3px;
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.12),
			0 24px 48px -24px rgb(0 0 0 / 0.45);
		color: var(--ink);
		color-scheme: light;
	}

	.place {
		color: var(--muted);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin-top: var(--space-1);
		font-family: 'Caveat', cursive;
		font-size: clamp(3rem, 9vw, 5rem);
		font-weight: 600;
		line-height: 1;
	}

	.dates {
		margin-top: var(--space-2);
		color: var(--muted);
	}

	/* Cover and side column. */
	.lead {
		display: grid;
		gap: var(--space-8);
		margin-top: var(--space-8);
	}

	@media (min-width: 48rem) {
		.lead {
			grid-template-columns: 1.6fr 1fr;
			align-items: start;
		}
	}

	/* A print: white border, a slight tilt, tape holding it down. */
	.print {
		position: relative;
		margin: 0;
		padding: 0.6rem 0.6rem 0.9rem;
		background: #fbfaf6;
		box-shadow:
			0 1px 1px rgb(0 0 0 / 0.15),
			0 10px 24px -12px rgb(0 0 0 / 0.5);
		transform: rotate(var(--tilt, 0deg));
	}

	.photo {
		display: block;
		width: 100%;
		height: auto;
	}

	.placeholder {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 3;
		background: linear-gradient(180deg, #4a4f7a, #b88aa8);
	}

	.placeholder .todo {
		border-color: rgb(255 255 255 / 0.8);
		color: #fff;
	}

	.print figcaption {
		margin-top: 0.4rem;
		font-family: 'Caveat', cursive;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.1;
		text-align: center;
	}

	/* Washi tape: translucent strips with torn ends. */
	.tape {
		position: absolute;
		z-index: 1;
		width: 6.5rem;
		height: 1.6rem;
		background: rgb(214 196 150 / 0.72);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
		mask: linear-gradient(90deg, transparent 0 2px, #000 2px calc(100% - 2px), transparent calc(100% - 2px)),
			repeating-linear-gradient(0deg, #000 0 3px, transparent 3px 5px);
		mask-composite: add;
	}

	.tape-l {
		top: -0.7rem;
		left: -1.4rem;
		transform: rotate(-32deg);
	}

	.tape-r {
		top: -0.7rem;
		right: -1.4rem;
		transform: rotate(28deg);
		background: rgb(170 190 210 / 0.7);
	}

	.tape-c {
		top: -0.8rem;
		left: calc(50% - 3.25rem);
		transform: rotate(-3deg);
	}

	/* The locator: a postage stamp with perforated edges. */
	.side {
		display: grid;
		gap: var(--space-6);
		justify-items: start;
	}

	.stamp {
		margin: 0;
		padding: 10px 10px 8px;
		background: #fbfaf6;
		/* Perforations: a row of half-circle bites along every edge. */
		mask:
			radial-gradient(circle 5px at 50% 0, transparent 98%, #000) 0 0 / 14px 51% repeat-x,
			radial-gradient(circle 5px at 50% 100%, transparent 98%, #000) 0 100% / 14px 51% repeat-x;
		filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.25));
		transform: rotate(3deg);
	}

	.stamp-picture {
		position: relative;
		width: 148px;
		height: 148px;
		background-color: #dfd6bf;
		background-repeat: no-repeat;
	}

	.stamp-pin {
		position: absolute;
		top: calc(50% - 7px);
		left: calc(50% - 7px);
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #8aa8ff, #2f5bd3 55%, #1c3a8f);
		box-shadow:
			0 0 0 2px rgb(255 255 255 / 0.8),
			0 2px 4px rgb(0 0 0 / 0.4);
	}

	.stamp figcaption {
		margin-top: 6px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-align: center;
	}

	.blurb {
		font-size: var(--text-lg);
		line-height: 1.55;
	}

	/* The journal: ruled paper with a margin line. */
	.journal {
		--rule: 1.75rem;
		margin-top: var(--space-12);
		padding: var(--rule) clamp(1rem, 4vw, 2.5rem) var(--rule) clamp(2.5rem, 7vw, 4.5rem);
		background:
			linear-gradient(90deg, transparent calc(clamp(2.5rem, 7vw, 4.5rem) - 1.1rem), rgb(200 80 80 / 0.35) 0 calc(clamp(2.5rem, 7vw, 4.5rem) - 1rem), transparent 0),
			repeating-linear-gradient(180deg, transparent 0 calc(var(--rule) - 1px), rgb(70 110 170 / 0.22) calc(var(--rule) - 1px) var(--rule)),
			#fbf8f0;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
		line-height: var(--rule);
	}

	.journal .prose :global(p),
	.journal .prose :global(li) {
		max-width: 65ch;
	}

	.journal .prose :global(* + *) {
		margin-top: var(--rule);
	}

	.journal .prose :global(h2),
	.journal .prose :global(h3) {
		font-family: 'Caveat', cursive;
		font-size: 2rem;
		line-height: var(--rule);
	}

	.journal .prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	/* The rest of the photos. */
	.photos {
		margin-top: var(--space-12);
	}

	.photos ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
		gap: var(--space-12) var(--space-8);
		padding: var(--space-4) 0 0;
		list-style: none;
	}

	.pager {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: 60rem;
		margin: var(--space-8) auto 0;
		font-weight: 600;
	}

	.pager a {
		text-decoration: none;
	}

	.pager a:hover {
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: no-preference) {
		.print {
			transition: transform 0.3s var(--ease-out);
		}

		.print:hover {
			transform: rotate(0deg) scale(1.01);
		}
	}
</style>
