---
/**
 * One trip's scrapbook page: a sheet of ivory card framed in gold (the desk's art deco), with the
 * cover photo taped on as a polaroid, a postage-stamp locator cut from the desk's map, the blurb,
 * the journal with a deco drop cap, and the rest of the photos as taped polaroids with
 * handwritten captions. Then on to the next trip. Clicking a photo opens it large (a <dialog>),
 * with the arrow keys or buttons stepping through the rest; without JavaScript, each photo links
 * to its large version.
 *
 * Missing dates or photos show as a visible TODO. The blurb and journal are optional: without
 * them, they're left out.
 * Every photo goes through astro:assets, which re-encodes it and strips EXIF/GPS metadata; the
 * original file is never published.
 */
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import '@fontsource/caveat/600.css';
import PageLayout from '../../layouts/PageLayout.astro';
import { MAP } from '../../lib/map/config';
import { createMapSheet, locate } from '../../lib/map/projection';
import { formatCoordinates, formatTripDates, getTrips, hasJournal, tripHref, tripName, type Trip } from '../../lib/trips';

export const getStaticPaths = (async () => {
	const trips = await getTrips();
	return trips.map((trip, i) => ({
		params: { slug: trip.id },
		// Wraps round, so the last trip leads back to the first.
		props: { trip, previous: trips[(i - 1 + trips.length) % trips.length], next: trips[(i + 1) % trips.length] },
	}));
}) satisfies GetStaticPaths;

const { trip, previous, next } = Astro.props as { trip: Trip; previous: Trip; next: Trip };
const { title, place, blurb, cover, coverAlt, photos, lat, lng } = trip.data;
const dates = formatTripDates(trip);
const { Content } = await render(trip);
const journal = hasJournal(trip);

// The locator stamp: the map texture, zoomed in around the trip's pin.
const sheet = createMapSheet(MAP);
const pin = locate(sheet, lat, lng);
const STAMP = 148; // px, the stamp's picture area
const ZOOM_WIDTH = 1700; // px, how wide the whole map sheet is drawn behind it
const stampStyle = pin
	? [
			`background-image: url(/map/${MAP.name}.webp)`,
			`background-size: ${ZOOM_WIDTH}px auto`,
			`background-position: ${STAMP / 2 - pin[0] * ZOOM_WIDTH}px ${STAMP / 2 - (pin[1] * ZOOM_WIDTH) / sheet.aspect}px`,
		].join('; ')
	: undefined;

// Link preview: the cover, cropped to 1200 × 630; without one, the default desk card.
const preview = cover
	? {
			src: (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src,
			alt: coverAlt ?? '',
		}
	: undefined;

// Every photo at a large size, for the viewer: the cover, then the gallery.
const large = async (src: ImageMetadata) => (await getImage({ src, width: 2000, format: 'webp', quality: 82 })).src;
const coverLarge = cover ? await large(cover) : undefined;
const photosLarge = await Promise.all(photos.map((p) => large(p.src)));

// Small deterministic tilts, so the prints look placed by hand rather than on a grid.
const tilt = (i: number) => [-2.2, 1.6, -1.1, 2.4, -1.8, 0.9][i % 6];
---

<PageLayout
	title={tripName(trip)}
	description={blurb ?? `${tripName(trip)}: a page from Aaron Yalong's travel scrapbook.`}
	image={preview}
	type="article"
>
	<article class="sheet">
		<header class="head">
			<p class="caps place"><span>{place}</span></p>
			<h1>{title}</h1>
			<p class="caps dates">{dates ?? <span class="todo">TODO: dates</span>}</p>
			<div class="deco-rule" aria-hidden="true"><span></span></div>
		</header>

		<div class="lead">
			<figure class="print cover" style={`--tilt: ${tilt(0)}deg`}>
				<span class="tape tape-l" aria-hidden="true"></span>
				<span class="tape tape-r" aria-hidden="true"></span>
				{
					cover ? (
						<a class="zoom" href={coverLarge} data-caption="">
							<Image src={cover} alt={coverAlt ?? ''} width={1100} class="photo" />
						</a>
					) : (
						<div class="photo placeholder">
							<span class="todo">TODO: cover photo</span>
						</div>
					)
				}
			</figure>

			<aside class="side">
				{
					pin && (
						<figure class="stamp" aria-label={`On the map: ${formatCoordinates(lat, lng)}`}>
							<div class="stamp-picture" style={stampStyle}>
								<span class="stamp-pin" aria-hidden="true" />
							</div>
							<figcaption>{formatCoordinates(lat, lng)}</figcaption>
						</figure>
					)
				}
				{blurb && <p class="blurb">{blurb}</p>}
			</aside>
		</div>

		{
			journal && (
				<section class="journal" aria-label="Journal">
					<div class="prose">
						<Content />
					</div>
				</section>
			)
		}

		<section class="photos" aria-label="Photos">
			{
				photos.length > 0 ? (
					<ul>
						{photos.map((photo, i) => (
							<li>
								<figure class="print" style={`--tilt: ${tilt(i + 1)}deg`}>
									<span class="tape tape-c" aria-hidden="true" />
									<a class="zoom" href={photosLarge[i]} data-caption={photo.caption ?? ''}>
										<Image src={photo.src} alt={photo.alt} width={700} class="photo" />
									</a>
									{photo.caption && <figcaption>{photo.caption}</figcaption>}
								</figure>
							</li>
						))}
					</ul>
				) : (
					<p>
						<span class="todo">TODO: photos</span>
					</p>
				)
			}
		</section>
	</article>

	{
		(cover || photos.length > 0) && (
			<dialog class="viewer" aria-label="Photo">
				<figure>
					<img alt="" />
					<figcaption />
				</figure>
				<p class="viewer-count" aria-live="polite" />
				<button type="button" class="viewer-close deco-tag" aria-label="Close">
					×
				</button>
				<button type="button" class="viewer-prev deco-tag" aria-label="Previous photo">
					←
				</button>
				<button type="button" class="viewer-next deco-tag" aria-label="Next photo">
					→
				</button>
			</dialog>
		)
	}

	<nav class="pager" aria-label="More trips">
		<a class="deco-tag" href={tripHref(previous)} rel="prev"><span aria-hidden="true">←</span> {tripName(previous)}</a>
		<a class="deco-tag" href={tripHref(next)} rel="next">{tripName(next)} <span aria-hidden="true">→</span></a>
	</nav>
</PageLayout>

<style>
	/* The page itself: a sheet of ivory card stock, framed with a double gold rule like a deco menu
	   card. Light inside, on the dark room. */
	.sheet {
		--ink: #2a2622;
		--muted: #6b6259;
		--color-accent: var(--gold-ink);
		--color-accent-hover: #5e4214;
		--color-text-muted: var(--muted);
		position: relative;
		max-width: 60rem;
		margin-inline: auto;
		padding: clamp(2.25rem, 6vw, 4.5rem) clamp(1.5rem, 6vw, 4rem);
		background:
			radial-gradient(circle at 20% 10%, rgb(255 255 255 / 0.5), transparent 55%),
			radial-gradient(circle at 90% 95%, rgb(120 90 50 / 0.08), transparent 50%),
			var(--paper);
		box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.8);
		color: var(--ink);
		color-scheme: light;
	}

	.sheet::before,
	.sheet::after {
		content: '';
		position: absolute;
		pointer-events: none;
	}

	.sheet::before {
		inset: 12px;
		border: 1.5px solid var(--gold-ink);
	}

	.sheet::after {
		inset: 19px;
		border: 1px solid color-mix(in srgb, var(--gold-ink) 55%, transparent);
		clip-path: polygon(18px 0, calc(100% - 18px) 0, 100% 18px, 100% calc(100% - 18px), calc(100% - 18px) 100%, 18px 100%, 0 calc(100% - 18px), 0 18px);
	}

	.head {
		text-align: center;
	}

	/* The place between two gold rules. */
	.place {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		color: var(--gold-ink);
		font-size: 0.78rem;
	}

	.place::before,
	.place::after {
		content: '';
		flex: 1;
		height: 1px;
		background: currentColor;
		opacity: 0.55;
	}

	h1 {
		margin-top: var(--space-4);
		font-size: clamp(2.4rem, 7vw, 4.25rem);
		letter-spacing: 0.12em;
		line-height: 1.05;
		text-transform: uppercase;
	}

	.dates {
		margin-top: var(--space-4);
		color: var(--muted);
		font-size: 0.8rem;
	}

	.head .deco-rule {
		max-width: 16rem;
		margin: var(--space-6) auto 0;
		color: var(--gold-ink);
	}

	/* Cover and side column. */
	.lead {
		display: grid;
		gap: var(--space-8);
		margin-top: var(--space-12);
	}

	@media (min-width: 48rem) {
		.lead {
			grid-template-columns: 1.6fr 1fr;
			align-items: start;
		}
	}

	.photos li {
		width: min(17rem, 100%);
	}

	/* A polaroid: white border, deeper at the bottom, a slight tilt, tape holding it down. */
	.print {
		position: relative;
		margin: 0;
		padding: 0.65rem 0.65rem 1rem;
		background: #fbfaf6;
		box-shadow:
			0 1px 1px rgb(0 0 0 / 0.15),
			0 10px 24px -12px rgb(0 0 0 / 0.5);
		transform: rotate(var(--tilt, 0deg));
	}

	.photo {
		display: block;
		width: 100%;
		height: auto;
	}

	.placeholder {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 3;
		background:
			radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.12), transparent 60%),
			linear-gradient(180deg, var(--navy), #2a3b55);
	}

	.placeholder .todo {
		border-color: rgb(255 255 255 / 0.8);
		color: #fff;
	}

	.print figcaption {
		margin-top: 0.45rem;
		font-family: var(--font-hand);
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.1;
		text-align: center;
	}

	/* Washi tape: translucent strips with torn ends. */
	.tape {
		position: absolute;
		z-index: 1;
		width: 6.5rem;
		height: 1.6rem;
		background: rgb(214 196 150 / 0.72);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
		mask: linear-gradient(90deg, transparent 0 2px, #000 2px calc(100% - 2px), transparent calc(100% - 2px)),
			repeating-linear-gradient(0deg, #000 0 3px, transparent 3px 5px);
		mask-composite: add;
	}

	.tape-l {
		top: -0.7rem;
		left: -1.4rem;
		transform: rotate(-32deg);
	}

	.tape-r {
		top: -0.7rem;
		right: -1.4rem;
		transform: rotate(28deg);
		background: rgb(201 164 92 / 0.55);
	}

	.tape-c {
		top: -0.8rem;
		left: calc(50% - 3.25rem);
		transform: rotate(-3deg);
	}

	/* The locator: a postage stamp with perforated edges. */
	.side {
		display: grid;
		gap: var(--space-6);
		justify-items: start;
	}

	.stamp {
		justify-self: center;
		margin: 0;
		padding: 10px 10px 8px;
		background: #fbfaf6;
		/* Perforations: a row of half-circle bites along every edge. */
		mask:
			radial-gradient(circle 5px at 50% 0, transparent 98%, #000) 0 0 / 14px 51% repeat-x,
			radial-gradient(circle 5px at 50% 100%, transparent 98%, #000) 0 100% / 14px 51% repeat-x;
		filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.25));
		transform: rotate(3deg);
	}

	.stamp-picture {
		position: relative;
		width: 148px;
		height: 148px;
		background-color: var(--navy);
		background-repeat: no-repeat;
	}

	/* A brass map pin, as on the desk. */
	.stamp-pin {
		position: absolute;
		top: calc(50% - 7px);
		left: calc(50% - 7px);
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #fff1c9, #c9a45c 45%, #6f4f1d);
		box-shadow:
			0 0 0 2px rgb(251 250 246 / 0.85),
			0 2px 4px rgb(0 0 0 / 0.45);
	}

	.stamp figcaption {
		margin-top: 6px;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-align: center;
	}

	.blurb {
		font-size: 1.2rem;
		line-height: 1.6;
	}

	/* The journal: between gold rules, opening with a deco drop cap. */
	.journal {
		margin-top: var(--space-12);
		padding-block: var(--space-8);
		border-block: 1px solid color-mix(in srgb, var(--gold-ink) 45%, transparent);
		font-size: 1.1rem;
		line-height: 1.75;
	}

	.journal .prose {
		max-width: 65ch;
		margin-inline: auto;
	}

	.journal .prose :global(* + *) {
		margin-top: 1.1em;
	}

	.journal .prose :global(> p:first-child::first-letter) {
		float: left;
		margin: 0.08em 0.12em 0 0;
		color: var(--gold-ink);
		font-family: var(--font-display);
		font-size: 4em;
		line-height: 0.8;
	}

	.journal .prose :global(h2),
	.journal .prose :global(h3) {
		margin-top: 1.6em;
		font-size: 1.5rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.journal .prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	/* The rest of the photos. */
	.photos {
		margin-top: var(--space-12);
	}

	/* Prints of a set width, in centred rows: a short last row (one print under two) sits in the
	   middle of the sheet, not to one side. */
	.photos ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-12) var(--space-8);
		padding: var(--space-4) 0 0;
		list-style: none;
	}

	/* On to the previous and next trips: deco tags on the dark room. */
	.pager {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-4);
		max-width: 60rem;
		margin: var(--space-12) auto 0;
	}

	.pager a {
		--cut: 8px;
		padding: 0.8rem 1.2rem 0.65rem;
		color: var(--ivory);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.pager a:hover,
	.pager a:focus-visible {
		--line: var(--gold-bright);
		--fill: color-mix(in srgb, #2a1f12 92%, transparent);
		color: var(--gold-bright);
		outline: none;
	}

	/* The photos open in the viewer. */
	.zoom {
		display: block;
		cursor: zoom-in;
	}

	.zoom:focus-visible {
		outline: 2px solid var(--gold-ink);
		outline-offset: 4px;
	}

	/* The viewer: one photo at a time, large, on the dark room. */
	.viewer {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ivory);
	}

	.viewer::backdrop {
		background: rgb(10 8 6 / 0.96);
	}

	.viewer[open] {
		display: grid;
		place-items: center;
	}

	.viewer figure {
		display: grid;
		justify-items: center;
		gap: var(--space-3);
		margin: 0;
		padding: 3.5rem 1rem 4.5rem;
	}

	.viewer img {
		display: block;
		max-width: min(92vw, 80rem);
		max-height: calc(100dvh - 9rem);
		width: auto;
		height: auto;
		box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.9);
	}

	.viewer figcaption {
		font-family: var(--font-hand);
		font-size: 1.6rem;
		font-weight: 600;
	}

	.viewer figcaption:empty {
		display: none;
	}

	.viewer-count {
		position: fixed;
		top: 1.4rem;
		left: 50%;
		transform: translateX(-50%);
		color: color-mix(in srgb, var(--ivory) 70%, transparent);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.2em;
	}

	.viewer button {
		--cut: 8px;
		position: fixed;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 0;
		color: var(--ivory);
		font: inherit;
		font-size: 1.3rem;
		cursor: pointer;
	}

	.viewer button:hover,
	.viewer button:focus-visible {
		--line: var(--gold-bright);
		--fill: color-mix(in srgb, #2a1f12 92%, transparent);
		color: var(--gold-bright);
		outline: none;
	}

	.viewer-close {
		top: 1rem;
		right: 1rem;
	}

	.viewer-prev,
	.viewer-next {
		top: calc(50% - 1.5rem);
	}

	.viewer-prev {
		left: 1rem;
	}

	.viewer-next {
		right: 1rem;
	}

	/* On a phone the arrows sit under the photo, not over it. */
	@media (max-width: 40rem) {
		.viewer-prev,
		.viewer-next {
			top: auto;
			bottom: 1rem;
		}

		.viewer-prev {
			left: calc(50% - 3.5rem);
		}

		.viewer-next {
			right: calc(50% - 3.5rem);
		}
	}

	.viewer[data-single] .viewer-prev,
	.viewer[data-single] .viewer-next,
	.viewer[data-single] .viewer-count {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.viewer[open] img {
			animation: viewer-in 0.25s var(--ease-out);
		}

		@keyframes viewer-in {
			from {
				opacity: 0;
				transform: scale(0.98);
			}
		}

		.print {
			transition: transform 0.3s var(--ease-out);
		}

		.print:hover {
			transform: rotate(0deg) scale(1.01);
		}
	}
</style>

<script>
	// The photo viewer: open the clicked photo in the <dialog>, step with the arrows (buttons or
	// keys), close with Esc, the × or a click outside the photo. Focus goes back to the photo.
	const viewer = document.querySelector<HTMLDialogElement>('dialog.viewer');
	const links = [...document.querySelectorAll<HTMLAnchorElement>('a.zoom')];
	if (viewer && links.length > 0 && typeof viewer.showModal === 'function') {
		const img = viewer.querySelector('img')!;
		const caption = viewer.querySelector('figcaption')!;
		const count = viewer.querySelector('.viewer-count')!;
		let current = 0;
		const show = (i: number) => {
			current = (i + links.length) % links.length;
			const link = links[current];
			img.src = link.href;
			img.alt = link.querySelector('img')?.alt ?? '';
			caption.textContent = link.dataset.caption ?? '';
			count.textContent = `${current + 1} / ${links.length}`;
		};
		viewer.toggleAttribute('data-single', links.length === 1);
		links.forEach((link, i) =>
			link.addEventListener('click', (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
				event.preventDefault();
				show(i);
				viewer.showModal();
			}),
		);
		viewer.querySelector('.viewer-close')!.addEventListener('click', () => viewer.close());
		viewer.querySelector('.viewer-prev')!.addEventListener('click', () => show(current - 1));
		viewer.querySelector('.viewer-next')!.addEventListener('click', () => show(current + 1));
		viewer.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			else if (event.key === 'ArrowRight') show(current + 1);
		});
		// A click on the dark around the photo (the dialog itself, not its contents) closes it.
		viewer.addEventListener('click', (event) => {
			if (event.target === viewer || event.target === viewer.querySelector('figure')) viewer.close();
		});
		viewer.addEventListener('close', () => {
			links[current].focus({ preventScroll: true });
			img.removeAttribute('src');
		});
	}
</script>
