---
/** Served for any address that doesn't exist (wrangler.jsonc: not_found_handling "404-page"). */
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Page not found" description="This page doesn't exist.">
	<div class="lost">
		<p class="caps code">Error 404</p>
		<h1>Off the map</h1>
		<div class="deco-rule" aria-hidden="true"><span></span></div>
		<p class="lede">Nothing's pinned here. Try the desk, or the list of every trip.</p>
		<ul class="links">
			<li><a class="deco-tag" href="/">The desk</a></li>
			<li><a class="deco-tag" href="/trips/">All trips</a></li>
		</ul>
	</div>
</PageLayout>

<style>
	.lost {
		max-width: 34rem;
		margin-inline: auto;
		text-align: center;
	}

	.code {
		color: var(--gold);
		font-size: 0.75rem;
	}

	h1 {
		margin-block: var(--space-2) var(--space-4);
		color: var(--ivory);
		font-size: clamp(2.4rem, 7vw, 3.75rem);
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.lede {
		margin-block: var(--space-4) var(--space-8);
		color: color-mix(in srgb, var(--ivory) 75%, transparent);
	}

	.links {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		padding: 0;
		list-style: none;
	}

	.links a {
		--cut: 8px;
		display: inline-block;
		padding: 0.8rem 1.2rem 0.65rem;
		color: var(--ivory);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.links a:hover,
	.links a:focus-visible {
		--line: var(--gold-bright);
		color: var(--gold-bright);
		outline: none;
	}
</style>
