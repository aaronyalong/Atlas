---
/**
 * "Skip the 3D": every trip as a plain list, for screen readers, slow phones and search engines.
 * Phase 1 stub: the names are hard-coded. Phase 2 builds this from the trips content collection
 * and links each trip to its scrapbook page.
 */
import PageLayout from '../layouts/PageLayout.astro';

const TRIPS = [
	'Tokyo, Japan',
	'Dallas, Texas',
	'Seoul, South Korea',
	'Zion National Park, Utah',
	'Portland, Oregon',
];
---

<PageLayout title="All trips" description="Every trip in Aaron Yalong's travel scrapbook, as a plain list.">
	<h1>All trips</h1>
	<p class="lede">The whole scrapbook as a plain list, without the 3D desk.</p>
	<ul class="trips">
		{
			TRIPS.map((name) => (
				<li>
					<span class="name">{name}</span>
					<span class="todo">TODO: dates, blurb, trip page</span>
				</li>
			))
		}
	</ul>
</PageLayout>

<style>
	.lede {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
	}

	.trips {
		max-width: var(--prose-width);
		margin-top: var(--space-8);
		padding: 0;
		list-style: none;
	}

	.trips li {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		padding-block: var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}

	.name {
		font-weight: 600;
	}
</style>
