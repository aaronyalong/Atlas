---
/**
 * Home: the 3D scrapbook desk.
 *
 * The page's HTML (title bar, "Skip the 3D" link, loading screen) arrives and paints before any
 * JavaScript runs. The desk is a React island with client:only="react": three.js needs a browser
 * (window, WebGL), so Astro doesn't try to render it on the server; until the island boots it
 * shows the `fallback` slot, which is the same loading screen the island then takes over.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@fontsource/caveat/600.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import DeskApp from '../components/desk/DeskApp';
import type { DeskMap, DeskTrip } from '../components/desk/types';
import { MAP } from '../lib/map/config';
import { createMapSheet, locate } from '../lib/map/projection';
import { PORTFOLIO_URL } from '../lib/site';
import { formatTripDates, getTrips, tripDays, tripHref } from '../lib/trips';
import '../styles/desk.css';

/*
 * Build time: turn the trips into the plain data the 3D island needs.
 *
 * Photos (the cover, then the gallery) go through Astro's image pipeline (sharp): resized,
 * re-encoded to WebP, and stripped of EXIF/GPS metadata. The island only ever sees the processed
 * files' URLs, and only loads them when that trip is opened. Each trip's lat/lng is projected
 * here, with the same code that drew the map texture (scripts/map.mjs), into a position on the
 * sheet; d3-geo never reaches the browser.
 */
const sheet = createMapSheet(MAP);
const deskMap: DeskMap = { src: `/map/${MAP.name}.webp`, width: MAP.sheetWidth, depth: MAP.sheetWidth / sheet.aspect };

const webp = async (src: ImageMetadata) => (await getImage({ src, width: 900, format: 'webp', quality: 80 })).src;

const deskTrips: DeskTrip[] = await Promise.all(
	(await getTrips()).map(async (trip) => {
		const { title, place, blurb, cover, coverAlt, photos, lat, lng, timeZone } = trip.data;
		const map = locate(sheet, lat, lng);
		if (!map) console.warn(`${trip.id} (${lat}, ${lng}) is outside the map's crop; it gets no pin. Widen the crop in src/lib/map/config.ts.`);
		const prints = [
			...(cover ? [{ src: await webp(cover), alt: coverAlt ?? '', caption: null }] : []),
			...(await Promise.all(photos.map(async (p) => ({ src: await webp(p.src), alt: p.alt, caption: p.caption ?? null })))),
		];
		return {
			slug: trip.id,
			title,
			place,
			dates: formatTripDates(trip),
			days: tripDays(trip),
			blurb: blurb ?? null,
			href: tripHref(trip),
			photos: prints,
			map,
			timeZone: timeZone ?? null,
		};
	}),
);
---

<BaseLayout bodyClass="desk-page on-dark">
	<header class="desk-topbar">
		<div class="desk-brand">
			<h1>Atlas</h1>
			<a href={PORTFOLIO_URL}>by Aaron Yalong</a>
		</div>
		<a class="deco-tag desk-pill" href="/trips/">Skip the 3D <span aria-hidden="true">→</span></a>
	</header>

	<main class="desk-stage">
		<DeskApp client:only="react" trips={deskTrips} map={deskMap}>
			<div slot="fallback" class="loader" role="status">
				<p class="loader-title">Unpacking the scrapbook…</p>
				<div class="loader-bar" data-indeterminate><span></span></div>
			</div>
		</DeskApp>
		<noscript>
			<style>
				.loader {
					display: none;
				}
			</style>
			<div class="desk-notice">
				<p>The 3D desk needs JavaScript.</p>
				<a class="deco-tag desk-pill" href="/trips/">See every trip as a list</a>
			</div>
		</noscript>
	</main>
</BaseLayout>
